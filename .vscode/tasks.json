{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动语料库网页（http://127.0.0.1:5731）",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "app.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "showReuseMessage": false,
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
